    CHAR szFileName[MAX_PATH];
    int wlen = wcslen(lpFileName);
    int blen = WideCharToMultiByte(LIBWINEVBS_PATH_CP, 0, lpFileName, wlen, szFileName, sizeof(szFileName) - 1, NULL, NULL);
@@ -1366,6 +1516,10 @@ HANDLE WINAPI FindFirstFileW(LPCWSTR lpFileName, LPWIN32_FIND_DATAW lpFindFileDa
 {
    if (!lpFileName || !lpFindFileData)
       return INVALID_HANDLE_VALUE;
+   WCHAR fenced[MAX_PATH];
+   if (!fence_allows(lpFileName, 0, fenced, MAX_PATH))
+      return INVALID_HANDLE_VALUE;
+   lpFileName = fenced;
 
    WCHAR pathW[MAX_PATH];
    wcsncpy(pathW, lpFileName, MAX_PATH);
@@ -1460,6 +1614,10 @@ BOOL WINAPI GetFileAttributesExW(LPCWSTR lpFileName, GET_FILEEX_INFO_LEVELS fInf
 DWORD WINAPI GetFileAttributesW(LPCWSTR lpFileName)
 {
    DWORD status = INVALID_FILE_ATTRIBUTES;
+   WCHAR fenced[MAX_PATH];
+   if (!fence_allows(lpFileName, 0, fenced, MAX_PATH))
+      return INVALID_FILE_ATTRIBUTES;
+   lpFileName = fenced;
    CHAR szFileName[MAX_PATH];
    int wlen = wcslen(lpFileName);
    int blen = WideCharToMultiByte(LIBWINEVBS_PATH_CP, 0, lpFileName, wlen, szFileName, sizeof(szFileName) - 1, NULL, NULL);
@@ -1499,6 +1657,19 @@ BOOL WINAPI GetFileSizeEx(HANDLE hFile, PLARGE_INTEGER lpFileSize)
 
 DWORD WINAPI GetFullPathNameW(LPCWSTR lpFileName, DWORD nBufferLength, LPWSTR lpBuffer, LPWSTR *lpFilePart)
 {
+   /* Visual Pinball Infinite: behind the fence, a relative path is taken from its base folder */
+   WCHAR full[MAX_PATH];
+   if (g_file_fence && fence_normalize(lpFileName, full, MAX_PATH)) {
+      DWORD len = wcslen(full);
+      if (!lpBuffer || nBufferLength <= len)
+         return len + 1;
+      wcscpy(lpBuffer, full);
+      if (lpFilePart) {
+         WCHAR *last = wcsrchr(lpBuffer, L'\\');
+         *lpFilePart = (last && last[1]) ? last + 1 : NULL;
+      }
+      return len;
+   }
    if (wcscmp(lpFileName, L".") == 0) {
       char currentDirBuffer[4096];
       size_t i;
