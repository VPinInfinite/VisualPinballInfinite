From c4fd119044d35ed968dc56762eff42318cb3aa67 Mon Sep 17 00:00:00 2001
From: VPinInfinite <340424849+VPinInfinite@users.noreply.github.com>
Subject: [PATCH 4/4] Visual Pinball Infinite: FormatNumber of a number written
 with an exponent

FormatNumber(CSng(0.0000043762975)) stopped with a type mismatch: the number
is first written as CStr writes it, "4.376298E-06", and GetNumberFormatW takes
no exponent. Such a string is now written out in full first, its digits as
they are ("0.000004376298"), so FormatNumber and FormatPercent give what
Microsoft's VBScript gives ("0.00", "-0.00" for a tiny negative number). Found
on VPX's Nudge Test and Calibration table, whose readouts format the nudge
sensor's tiny values.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 wine/dlls/vbscript/global.c | 59 ++++++++++++++++++++++++++++++++++++-
 1 file changed, 58 insertions(+), 1 deletion(-)

diff --git a/wine/dlls/vbscript/global.c b/wine/dlls/vbscript/global.c
index 56c4a74..5cc7de4 100644
--- a/wine/dlls/vbscript/global.c
+++ b/wine/dlls/vbscript/global.c
@@ -4148,18 +4148,75 @@ static HRESULT Global_ScriptEngineBuildVersion(BuiltinDisp *This, VARIANT *arg,
  * will then reformat using the target locale. */
 #define LCID_EN_US MAKELCID(MAKELANGID(LANG_ENGLISH, SUBLANG_ENGLISH_US), SORT_DEFAULT)
 
+/* Visual Pinball Infinite: GetNumberFormatW takes no exponent, so a number the conversion
+ * writes with one ("4.376298E-06", as CStr writes it) is written out in full first, its
+ * digits as they are ("0.000004376298"), as Microsoft's VBScript formats it. NULL when the
+ * string has no exponent, or isn't a plain number with one. */
+static BSTR expand_exponent(const WCHAR *str)
+{
+    WCHAR digits[64], plain[400];
+    int ndigits = 0, point = -1, exponent, i, o = 0;
+    const WCHAR *p = str, *e;
+    WCHAR *end;
+
+    for(e = str; *e && *e != 'E' && *e != 'e'; e++);
+    if(!*e)
+        return NULL;
+    if(*p == '-')
+        plain[o++] = *p++;
+    for(; p < e; p++) {
+        if(*p == '.' && point < 0)
+            point = ndigits;
+        else if(*p >= '0' && *p <= '9' && ndigits < ARRAY_SIZE(digits))
+            digits[ndigits++] = *p;
+        else
+            return NULL;
+    }
+    if(!ndigits)
+        return NULL;
+    if(point < 0)
+        point = ndigits;
+    exponent = wcstol(e + 1, &end, 10);
+    if(*end || exponent > 300 || exponent < -300)
+        return NULL;
+    point += exponent;
+    if(point <= 0) {
+        plain[o++] = '0';
+        plain[o++] = '.';
+        for(i = 0; i < -point; i++)
+            plain[o++] = '0';
+        for(i = 0; i < ndigits; i++)
+            plain[o++] = digits[i];
+    }else {
+        for(i = 0; i < point; i++)
+            plain[o++] = i < ndigits ? digits[i] : '0';
+        if(point < ndigits) {
+            plain[o++] = '.';
+            for(i = point; i < ndigits; i++)
+                plain[o++] = digits[i];
+        }
+    }
+    plain[o] = 0;
+    return SysAllocString(plain);
+}
+
 static HRESULT format_number_lcid(LCID lcid, VARIANT *var, int ndigits, int nleading,
         int nparens, int ngrouping, BSTR *out)
 {
     WCHAR buff[256], decimal[8], thousands[8];
     NUMBERFMTW fmt;
-    BSTR str;
+    BSTR str, plain;
     HRESULT hres;
 
     *out = NULL;
     hres = to_string(LCID_EN_US, var, &str);
     if(FAILED(hres))
         return hres;
+    plain = expand_exponent(str);
+    if(plain) {
+        SysFreeString(str);
+        str = plain;
+    }
 
     if(ndigits < 0)
         LOCNUM_INTO(lcid, LOCALE_IDIGITS, fmt.NumDigits);
-- 
