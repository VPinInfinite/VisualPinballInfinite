-         target_link_libraries(dmdutil_test_s PUBLIC dmdutil_static cargs64 zedmd64 serum64 usb64-1.0 serialport64 sockpp64 pupdmd64 ws2_32)
+         target_link_libraries(dmdutil_test_s PUBLIC dmdutil_static cargs64 zedmd64 ${DMDUTIL_SERUM64} usb64-1.0 serialport64 sockpp64 pupdmd64 ws2_32)
          if(ENABLE_VNI)
