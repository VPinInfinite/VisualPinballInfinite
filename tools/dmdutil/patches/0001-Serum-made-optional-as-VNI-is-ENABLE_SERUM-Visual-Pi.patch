From 9205df9358fa96e717b6812aba4d008c0031d495 Mon Sep 17 00:00:00 2001
From: VPinInfinite <340424849+VPinInfinite@users.noreply.github.com>
Subject: [PATCH] Serum made optional, as VNI is: ENABLE_SERUM (Visual Pinball
 Infinite)

With ENABLE_SERUM off, nothing of libserum is compiled in or linked:
its includes, its log callback, the Serum thread's body and the
queueing of its frames are left out (DMDUTIL_ENABLE_SERUM), and the
link lines name serum64 only when it's on. Upstream's default, on, is
unchanged. Visual Pinball Infinite builds libdmdutil with it off: its
engine is GPL-3.0-or-later and libserum ships the GPL's version 2 text
alone, so libserum runs in a program of its own (vpi-colour).
---
 CMakeLists.txt | 34 ++++++++++++++++++++++------------
 src/DMD.cpp    | 12 ++++++++++++
 2 files changed, 34 insertions(+), 12 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 842ca1e..ed3b165 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -8,6 +8,7 @@ option(BUILD_STATIC "Option to build static library" ON)
 option(POST_BUILD_COPY_EXT_LIBS "Option to copy external libraries to build directory" ON)
 option(ENABLE_SANITIZERS "Enable AddressSanitizer and UBSan for Debug builds" OFF)
 option(ENABLE_VNI "Enable VNI colorization support" ON)
+option(ENABLE_SERUM "Enable Serum colorization support" ON)
 
 message(STATUS "PLATFORM: ${PLATFORM}")
 message(STATUS "ARCH: ${ARCH}")
@@ -17,6 +18,7 @@ message(STATUS "BUILD_STATIC: ${BUILD_STATIC}")
 message(STATUS "POST_BUILD_COPY_EXT_LIBS: ${POST_BUILD_COPY_EXT_LIBS}")
 message(STATUS "ENABLE_SANITIZERS: ${ENABLE_SANITIZERS}")
 message(STATUS "ENABLE_VNI: ${ENABLE_VNI}")
+message(STATUS "ENABLE_SERUM: ${ENABLE_SERUM}")
 
 if(PLATFORM STREQUAL "ios" OR PLATFORM STREQUAL "ios-simulator")
    set(CMAKE_SYSTEM_NAME iOS)
@@ -111,6 +113,14 @@ set(DMDUTIL_COMPILE_DEFINITIONS "")
 if(ENABLE_VNI)
    list(APPEND DMDUTIL_COMPILE_DEFINITIONS DMDUTIL_ENABLE_VNI)
 endif()
+if(ENABLE_SERUM)
+   list(APPEND DMDUTIL_COMPILE_DEFINITIONS DMDUTIL_ENABLE_SERUM)
+   set(DMDUTIL_SERUM64 serum64)
+   set(DMDUTIL_SERUM serum)
+else()
+   set(DMDUTIL_SERUM64 "")
+   set(DMDUTIL_SERUM "")
+endif()
 
 if(PLATFORM STREQUAL "win" OR PLATFORM STREQUAL "win-mingw" OR PLATFORM STREQUAL "macos" OR PLATFORM STREQUAL "linux")
    list(APPEND DMDUTIL_SOURCES
@@ -139,12 +149,12 @@ if(BUILD_SHARED)
          third-party/runtime-libs/${PLATFORM}/${ARCH}
       )
       if(ARCH STREQUAL "x64")
-         target_link_libraries(dmdutil_shared PUBLIC cargs64 zedmd64 serum64 libusb64-1.0 libserialport64 sockpp64 pupdmd64 ws2_32)
+         target_link_libraries(dmdutil_shared PUBLIC cargs64 zedmd64 ${DMDUTIL_SERUM64} libusb64-1.0 libserialport64 sockpp64 pupdmd64 ws2_32)
          if(ENABLE_VNI)
             target_link_libraries(dmdutil_shared PUBLIC vni64)
          endif()
       else()
-        target_link_libraries(dmdutil_shared PUBLIC cargs zedmd serum libusb-1.0 libserialport sockpp pupdmd ws2_32)
+        target_link_libraries(dmdutil_shared PUBLIC cargs zedmd ${DMDUTIL_SERUM} libusb-1.0 libserialport sockpp pupdmd ws2_32)
         if(ENABLE_VNI)
            target_link_libraries(dmdutil_shared PUBLIC vni)
         endif()
@@ -154,7 +164,7 @@ if(BUILD_SHARED)
          third-party/build-libs/${PLATFORM}/${ARCH}
          third-party/runtime-libs/${PLATFORM}/${ARCH}
       )
-      target_link_libraries(dmdutil_shared PUBLIC cargs64 zedmd64 serum64 usb64-1.0 serialport64 sockpp64 pupdmd64 ws2_32)
+      target_link_libraries(dmdutil_shared PUBLIC cargs64 zedmd64 ${DMDUTIL_SERUM64} usb64-1.0 serialport64 sockpp64 pupdmd64 ws2_32)
