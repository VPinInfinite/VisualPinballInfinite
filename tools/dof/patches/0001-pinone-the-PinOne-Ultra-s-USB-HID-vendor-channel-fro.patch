new file mode 100644
index 0000000..de35efc
--- /dev/null
+++ b/src/cab/out/pinone/PinOneHidCommunication.cpp
@@ -0,0 +1,123 @@
+#include "PinOneHidCommunication.h"
+#include "../../../Log.h"
+#include "../../../general/StringExtensions.h"
+
+#include <hidapi/hidapi.h>
+#include <algorithm>
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#endif
+
+namespace DOF
+{
+
+PinOneHidDevice::PinOneHidDevice(hid_device* fp, const std::string& path, uint16_t vendorID, uint16_t productID)
+   : m_fp(fp)
+   , m_path(path)
+   , m_vendorID(vendorID)
+   , m_productID(productID)
+{
+}
+
+PinOneHidDevice::~PinOneHidDevice() { Close(); }
+
+void PinOneHidDevice::Close()
+{
+   if (m_fp)
+   {
+      hid_close(m_fp);
+      m_fp = nullptr;
+   }
+}
+
+bool PinOneHidDevice::WriteUSB(const std::vector<uint8_t>& payload)
+{
+   uint8_t buf[PinOneHidCommunication::ReportSize] = {};
+   buf[0] = PinOneHidCommunication::ReportId;
+   std::copy(payload.begin(), payload.begin() + std::min(payload.size(), sizeof(buf) - 1), buf + 1);
+
+   for (int tries = 0; tries < 3; ++tries)
+   {
+      int actual = m_fp ? hid_write(m_fp, buf, sizeof(buf)) : -1;
+      if (actual < 0)
+      {
+         if (TryReopenHandle())
+            continue;
+
+         Log::Error(StringExtensions::Build("PinOne Controller USB error sending request to device: {0}", GetLastWin32ErrMsg()));
+         return false;
+      }
+      else if (actual != static_cast<int>(sizeof(buf)))
+      {
+         Log::Error("PinOne Controller USB error sending request: not all bytes sent");
+         return false;
+      }
+      else
+         return true;
+   }
+
+   return false;
+}
+
+bool PinOneHidDevice::TryReopenHandle()
+{
+   Log::Error("PinOne Controller: invalid handle on write; trying to reopen handle");
+   Close();
+   m_fp = hid_open_path(m_path.c_str());
+   return m_fp != nullptr;
+}
+
+std::string PinOneHidDevice::GetLastWin32ErrMsg()
+{
+   const wchar_t* error = hid_error(m_fp);
+   std::string errorStr = "Unknown error";
+   if (error)
+   {
+#ifdef _WIN32
+      int size = WideCharToMultiByte(CP_UTF8, 0, error, -1, nullptr, 0, nullptr, nullptr);
+      if (size > 0)
+      {
+         errorStr.resize(size - 1);
+         WideCharToMultiByte(CP_UTF8, 0, error, -1, &errorStr[0], size, nullptr, nullptr);
+      }
+#else
+      std::wstring ws(error);
+      errorStr = std::string(ws.begin(), ws.end());
+#endif
+   }
+   return errorStr;
+}
+
+PinOneHidDevice* PinOneHidCommunication::FindDevice()
+{
+   std::vector<PinOneHidDevice*> devices = FindDevices();
+   for (size_t i = 1; i < devices.size(); i++)
+      delete devices[i];
+   return devices.size() > 0 ? devices[0] : nullptr;
+}
+
+std::vector<PinOneHidDevice*> PinOneHidCommunication::FindDevices()
+{
+   std::vector<PinOneHidDevice*> devices;
+
+   struct hid_device_info* devs = hid_enumerate(VendorID, ProductID);
+   for (struct hid_device_info* cur = devs; cur; cur = cur->next)
+   {
+      if (cur->usage_page != UsagePage || cur->usage != Usage || !cur->path)
+         continue;
+
+      hid_device* fp = hid_open_path(cur->path);
+      if (!fp)
+         continue;
+
+      devices.push_back(new PinOneHidDevice(fp, cur->path, cur->vendor_id, cur->product_id));
+   }
+   hid_free_enumeration(devs);
+
+   return devices;
+}
+
+}
diff --git a/src/cab/out/pinone/PinOneHidCommunication.h b/src/cab/out/pinone/PinOneHidCommunication.h
new file mode 100644
index 0000000..b283d9f
--- /dev/null
+++ b/src/cab/out/pinone/PinOneHidCommunication.h
@@ -0,0 +1,52 @@
+#pragma once
+
+// Ported from DirectOutput's PinOneHidCommunication.cs by Cleveland Software Design (DirectOutput
+// pull request #27, MIT) for Visual Pinball Infinite.
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+struct hid_device_;
+typedef struct hid_device_ hid_device;
+
+namespace DOF
+{
+
+class PinOneHidDevice
+{
+public:
+   PinOneHidDevice(hid_device* fp, const std::string& path, uint16_t vendorID, uint16_t productID);
+   ~PinOneHidDevice();
+
+   const std::string& GetPath() const { return m_path; }
+   uint16_t GetVendorID() const { return m_vendorID; }
+   uint16_t GetProductID() const { return m_productID; }
+   void Close();
+   bool WriteUSB(const std::vector<uint8_t>& payload);
+
+private:
+   bool TryReopenHandle();
+   std::string GetLastWin32ErrMsg();
+
+   hid_device* m_fp;
+   std::string m_path;
+   uint16_t m_vendorID;
+   uint16_t m_productID;
+};
+
+class PinOneHidCommunication
+{
+public:
+   static constexpr uint16_t VendorID = 0x39F5;
+   static constexpr uint16_t ProductID = 0x9208;
+   static constexpr uint16_t UsagePage = 0xFF00;
+   static constexpr uint16_t Usage = 0x01;
+   static constexpr uint8_t ReportId = 6;
+   static constexpr int ReportSize = 64;
+
+   static PinOneHidDevice* FindDevice();
+   static std::vector<PinOneHidDevice*> FindDevices();
+};
+
+}
