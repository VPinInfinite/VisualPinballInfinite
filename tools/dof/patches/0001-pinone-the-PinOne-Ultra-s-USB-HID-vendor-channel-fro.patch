+std::string PinOneAutoConfigurator::FindLegacyComPort(bool& wmiAvailable)
+{
+   wmiAvailable = true;
+
+   struct sp_port** portList;
+   if (sp_list_ports(&portList) != SP_OK)
+   {
+      Log::Exception("Error searching for legacy PinOne COM port via WMI");
+      wmiAvailable = false;
+      return "";
+   }
+
+   std::string comPort = "";
+   for (int i = 0; portList[i] != nullptr && comPort.empty(); i++)
+   {
+      int vid = 0;
+      int pid = 0;
+      if (sp_get_port_transport(portList[i]) != SP_TRANSPORT_USB || sp_get_port_usb_vid_pid(portList[i], &vid, &pid) != SP_OK)
