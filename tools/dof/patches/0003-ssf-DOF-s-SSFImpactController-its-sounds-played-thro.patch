+#pragma once
+
+// Ported from DirectOutput's SSFImpactController.cs (Kai "MrKai" Cherry's, MIT) for Visual Pinball
+// Infinite; its sounds play through SSFBass (miniaudio) where DOF's play through BASS.
+
+#include "../OutputControllerBase.h"
+#include <cstdint>
+#include <map>
+#include <string>
+#include <vector>
+#include <tinyxml2/tinyxml2.h>
+
+namespace DOF
+{
+
+class SSFnoid
+{
+public:
+   bool m_fired = false;
+   uint8_t m_value = 0;
+   int m_number = 0;
+
+   void Activate() { }
+};
+
+class SSFGear : public SSFnoid
+{
+public:
+   void SetShaker1(const std::string& value);
+   void SetGearLevel(float value) { m_gearVolume = value; }
+   void GearSet(uint8_t state);
+
+private:
+   int m_running = 0;
+   float m_gearVolume = 1.0f;
+   uint32_t m_shakerChannel1 = 0;
+   std::string m_bassShaker1 = "RearCenter";
+};
+
+class Faker
+{
+public:
+   Faker();
+
+   void SetShaker1(const std::string& value);
+   void SetShaker2(const std::string& value);
+   void SetImpactEffect(float value) { m_impactMod = value; }
+   void TurnOn();
+   void TurnOff();
+   void SetSpeed(uint8_t speed);
+
+private:
+   bool m_isShaking = false;
+   uint8_t m_currentValue = 0;
+   int m_running = 0;
+   int m_running2 = 0;
+   uint32_t m_shakerChannel1 = 0;
+   uint32_t m_shakerChannel2 = 0;
+   float m_impactMod = 1.0f;
+   std::string m_bassShaker1 = "RearCenter";
+   std::string m_bassShaker2 = "Rear";
+};
+
+class SoundBank
+{
+public:
+   static std::vector<std::string>& GetNames() { return s_names; }
+   static std::vector<int>& GetPorts() { return s_ports; }
+
+   std::vector<std::string> BankNames() { return s_names; }
+   void PrepBox(int deviceNumber);
+
+private:
+   static std::vector<int> s_ports;
+   static std::vector<std::string> s_names;
+};
+
+class SSFImpactController : public OutputControllerBase
+{
+public:
+   SSFImpactController();
+   ~SSFImpactController();
+
+   static const std::map<uint32_t, std::string>& GetSpeakerNames();
+
+   const std::string& GetFrontExciters() const { return m_frontExciters; }
+   void SetFrontExciters(const std::string& value) { m_frontExciters = value; }
+   const std::string& GetRearExciters() const { return m_rearExciters; }
+   void SetRearExciters(const std::string& value) { m_rearExciters = value; }
+   const std::string& GetBassShaker1() const { return m_shaker1; }
+   void SetBassShaker1(const std::string& value) { m_shaker1 = value; }
+   const std::string& GetBassShaker2() const { return m_shaker2; }
+   void SetBassShaker2(const std::string& value) { m_shaker2 = value; }
+   std::string GetLowImpactMode() const { return m_lowImpactMode ? "True" : "False"; }
+   void SetLowImpactMode(const std::string& value);
+   int GetDeviceNumber() const { return m_deviceNumber; }
+   void SetDeviceNumber(int value) { m_deviceNumber = value; }
+   float GetImpactFactor() const { return m_impactAmount; }
+   void SetImpactFactor(float value) { m_impactAmount = value / 100; }
+   float GetShakerImpactFactor() const { return m_shakeAmount; }
+   void SetShakerImpactFactor(float value) { m_shakeAmount = value / 100; }
+   float GetFlipperLevel() const { return m_flipperVolume; }
+   void SetFlipperLevel(float value) { m_flipperVolume = value / 100; }
+   float GetBumperLevel() const { return m_bumperVolume; }
+   void SetBumperLevel(float value) { m_bumperVolume = value / 100; }
+   float GetSlingsLevel() const { return m_slingsEtAlVolume; }
+   void SetSlingsLevel(float value) { m_slingsEtAlVolume = value / 100; }
+   float GetGearLevel() const { return m_gearLevel; }
+   void SetGearLevel(float value) { m_gearLevel = value / 100; }
+
+   void Init(class Cabinet* cabinet) override;
+   void Finish() override;
+   void Update() override;
+
+   tinyxml2::XMLElement* ToXml(tinyxml2::XMLDocument& doc) const override;
+   bool FromXml(const tinyxml2::XMLElement* element) override;
+   std::string GetXmlElementName() const override { return "SSFImpactController"; }
+
+protected:
+   void OnOutputValueChanged(class IOutput* output) override;
+
+private:
+   void AddOutputs();
+
+   std::string m_frontExciters = "Rear";
+   std::string m_rearExciters = "RearCenter";
+   std::string m_shaker1 = "RearCenter";
+   std::string m_shaker2 = "Rear";
+   bool m_lowImpactMode = false;
+   int m_deviceNumber = -1;
+   float m_impactAmount = 1.0f;
+   float m_shakeAmount = 1.0f;
+   float m_gearLevel = 0.65f;
+   uint32_t m_frontExciterPair = 0;
+   uint32_t m_rearExciterPair = 0;
+   uint32_t m_shakerChannel1 = 0;
