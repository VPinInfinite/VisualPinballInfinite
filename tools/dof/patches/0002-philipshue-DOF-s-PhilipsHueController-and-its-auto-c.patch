@@ -0,0 +1,134 @@
+#pragma once
+
+// Ported from DirectOutput's PhilipsHueController.cs (Rambo3's, MIT) for Visual Pinball Infinite.
+
+#include "../OutputControllerBase.h"
+#include <atomic>
+#include <condition_variable>
+#include <map>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <tinyxml2/tinyxml2.h>
+
+namespace DOF
+{
+
+class LocalHueClient;
+
+class PhilipsHueController : public OutputControllerBase
+{
+private:
+   std::mutex m_idUpdateLocker;
+   int m_id = 0;
+   std::string m_bridgeIP = "";
+   std::string m_bridgeKey = "";
+   std::string m_bridgeDeviceType = "dof_app#pincab";
+
+public:
+   int GetId() const { return m_id; }
+   void SetId(int value);
+   const std::string& GetBridgeIP() const { return m_bridgeIP; }
+   void SetBridgeIP(const std::string& value);
+   const std::string& GetBridgeKey() const { return m_bridgeKey; }
+   void SetBridgeKey(const std::string& value);
+   const std::string& GetBridgeDeviceType() const { return m_bridgeDeviceType; }
+   void SetBridgeDeviceType(const std::string& value);
+
+   void Update() override;
+   void Init(class Cabinet* cabinet) override;
