+#include "PhilipsHueAutoConfigurator.h"
+#include "PhilipsHueController.h"
+#include "../../Cabinet.h"
+#include "../OutputControllerList.h"
+#include "../../../general/StringExtensions.h"
+#include "../../../Log.h"
+#include "../../toys/lwequivalent/LedWizEquivalent.h"
+#include "../../toys/ToyList.h"
+
+namespace DOF
+{
+
+void PhilipsHueAutoConfigurator::AutoConfig(Cabinet* cabinet)
+{
+   int idCounter = 0;
+
+   Log::Write("PhilipsHueAutoConfigurator.AutoConfig started...note, actual connection detection will happen asynchronously, and device disabled if not succesfull (check further down in the log)");
+
+   OutputControllerList* controllers = cabinet->GetOutputControllers();
+   for (size_t c = 0; c < controllers->size(); c++)
+   {
+      PhilipsHueController* phc = dynamic_cast<PhilipsHueController*>(controllers->at(c));
+      if (phc)
+      {
+         Log::Write("PhilipsHueAutoConfigurator.AutoConfig...found existing instance, adding output toys to: " + phc->GetName());
+
+         phc->SetId(idCounter);
+         phc->SetBridgeIP(std::string(phc->GetBridgeIP()));
+         phc->SetBridgeKey(std::string(phc->GetBridgeKey()));
+
+         phc->ConnectHub();
+
+         if (!controllers->Contains(phc->GetName()))
+         {
+            controllers->push_back(phc);
+            Log::Write(StringExtensions::Build("Detected and added PhilipsHueController Id {0} with name {1}", std::to_string(phc->GetId()), phc->GetName()));
+         }
+
+         bool foundEquivalent = false;
+         for (auto* toy : *cabinet->GetToys())
+         {
+            LedWizEquivalent* lwe = dynamic_cast<LedWizEquivalent*>(toy);
+            if (lwe && lwe->GetLedWizNumber() == phc->GetId() - 0 + 70)
+            {
+               foundEquivalent = true;
+               break;
+            }
+         }
+
+         if (!foundEquivalent)
+         {
+            LedWizEquivalent* lwe = new LedWizEquivalent();
+            lwe->SetLedWizNumber(phc->GetId() - 0 + 70);
+            lwe->SetName(StringExtensions::Build("{0} Equivalent 1", phc->GetName()));
+            for (int i = 1; i <= 150; i++)
+            {
+               LedWizEquivalentOutput* lweo = new LedWizEquivalentOutput();
+               lweo->SetOutputName(StringExtensions::Build("{0}\\{0}.{1:00}", phc->GetName(), std::to_string(i)));
+               lweo->SetLedWizEquivalentOutputNumber(i);
+               lwe->GetOutputs().AddOutput(lweo);
+            }
+            if (!cabinet->GetToys()->Contains(lwe->GetName()))
+            {
+               cabinet->GetToys()->push_back(lwe);
+               Log::Write(StringExtensions::Build(
+                  "Added LedwizEquivalent Nr. {0} with name {1} for PhilipsHueController with Id {2}", std::to_string(lwe->GetLedWizNumber()), lwe->GetName(), std::to_string(phc->GetId())));
+            }
+            else
+               delete lwe;
+         }
+
+         idCounter++;
+      }
+   }
+}
+
+}
