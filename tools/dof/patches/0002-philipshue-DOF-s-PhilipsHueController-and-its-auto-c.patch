index 0000000..9c612ac
--- /dev/null
+++ b/src/cab/out/philipshue/LocalHueClient.cpp
@@ -0,0 +1,376 @@
+#include "LocalHueClient.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cerrno>
+#include <chrono>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#else
+#include <fcntl.h>
+#include <netdb.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <unistd.h>
+#endif
+
+namespace DOF
+{
+
+namespace
+{
+
+#ifdef _WIN32
+typedef SOCKET Socket;
+const Socket InvalidSocket = INVALID_SOCKET;
+void CloseSocket(Socket s) { closesocket(s); }
+#else
+typedef int Socket;
+const Socket InvalidSocket = -1;
+void CloseSocket(Socket s) { close(s); }
+#endif
+
+const int RequestTimeoutMs = 2000;
+const size_t MaxResponseSize = 8 * 1024 * 1024;
+
+bool AlmostEquals(double a, double b) { return std::abs(a - b) <= static_cast<double>(1.401298464324817E-45f); }
+
+std::string ToLower(std::string s)
+{
+   std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+   return s;
+}
+
+bool ConnectWithTimeout(Socket s, const sockaddr* addr, int addrLen, int timeoutMs)
+{
+#ifdef _WIN32
+   u_long nonBlocking = 1;
+   ioctlsocket(s, FIONBIO, &nonBlocking);
+   if (connect(s, addr, addrLen) == SOCKET_ERROR)
+   {
+      if (WSAGetLastError() != WSAEWOULDBLOCK)
+         return false;
+      fd_set writeSet;
+      FD_ZERO(&writeSet);
+      FD_SET(s, &writeSet);
+      fd_set errorSet;
+      FD_ZERO(&errorSet);
+      FD_SET(s, &errorSet);
+      timeval tv { timeoutMs / 1000, (timeoutMs % 1000) * 1000 };
+      if (select(0, nullptr, &writeSet, &errorSet, &tv) <= 0 || FD_ISSET(s, &errorSet))
+         return false;
+   }
+   u_long blocking = 0;
+   ioctlsocket(s, FIONBIO, &blocking);
+   DWORD t = static_cast<DWORD>(timeoutMs);
+   setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, reinterpret_cast<const char*>(&t), sizeof(t));
+   setsockopt(s, SOL_SOCKET, SO_SNDTIMEO, reinterpret_cast<const char*>(&t), sizeof(t));
+#else
+   int flags = fcntl(s, F_GETFL, 0);
+   fcntl(s, F_SETFL, flags | O_NONBLOCK);
+   if (connect(s, addr, static_cast<socklen_t>(addrLen)) < 0)
+   {
+      if (errno != EINPROGRESS)
+         return false;
+      pollfd p { s, POLLOUT, 0 };
+      if (poll(&p, 1, timeoutMs) <= 0)
+         return false;
+      int err = 0;
+      socklen_t len = sizeof(err);
+      if (getsockopt(s, SOL_SOCKET, SO_ERROR, &err, &len) < 0 || err != 0)
+         return false;
+   }
+   fcntl(s, F_SETFL, flags);
+   timeval tv { timeoutMs / 1000, (timeoutMs % 1000) * 1000 };
+   setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+   setsockopt(s, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+#endif
+   return true;
+}
+
+bool ResponseComplete(const std::string& raw)
+{
+   size_t headerEnd = raw.find("\r\n\r\n");
+   if (headerEnd == std::string::npos)
+      return false;
+   std::string head = ToLower(raw.substr(0, headerEnd));
+   size_t bodyLength = raw.size() - headerEnd - 4;
+   if (head.find("transfer-encoding: chunked") != std::string::npos)
+      return raw.size() >= 5 && raw.compare(raw.size() - 5, 5, "0\r\n\r\n") == 0;
+   size_t lengthAt = head.find("content-length:");
+   if (lengthAt != std::string::npos)
+      return bodyLength >= std::strtoull(head.c_str() + lengthAt + 15, nullptr, 10);
+   return false;
+}
+
+std::string Dechunk(const std::string& body)
+{
+   std::string out;
+   size_t at = 0;
+   while (at < body.size())
+   {
+      size_t lineEnd = body.find("\r\n", at);
+      if (lineEnd == std::string::npos)
+         break;
+      size_t size = std::strtoull(body.substr(at, lineEnd - at).c_str(), nullptr, 16);
+      if (size == 0)
+         break;
+      at = lineEnd + 2;
+      out.append(body, at, std::min(size, body.size() - at));
+      at += size + 2;
+   }
+   return out;
+}
+
+}
+
+LightCommand& LightCommand::TurnOff()
+{
+   m_on = false;
+   return *this;
+}
+
+LightCommand& LightCommand::SetColor(const std::string& hexColor)
+{
+   double r = std::strtol(hexColor.substr(0, 2).c_str(), nullptr, 16) / 255.0;
+   double g = std::strtol(hexColor.substr(2, 2).c_str(), nullptr, 16) / 255.0;
+   double b = std::strtol(hexColor.substr(4, 2).c_str(), nullptr, 16) / 255.0;
+   double min = std::min({ r, g, b });
+   double max = std::max({ r, g, b });
+
+   double hue = 0;
+   if (!(r == g && g == b))
+   {
+      double delta = max - min;
+      if (AlmostEquals(r, max))
+         hue = (g - b) / delta;
+      else if (AlmostEquals(g, max))
+         hue = 2 + (b - r) / delta;
+      else
+         hue = 4 + (r - g) / delta;
+      hue *= 60;
+      if (hue < 0)
+         hue += 360;
+      hue *= static_cast<double>(182.04f);
+   }
+   double saturation = AlmostEquals(max, min) ? 0 : (AlmostEquals(max, 0) ? 0 : 1 - (1 * min / max)) * 255;
+   double brightness = max * 255;
+
+   const int hueMaxValue = 65535;
+   m_brightness = static_cast<uint8_t>(static_cast<int>(brightness));
+   m_hue = ((static_cast<int>(hue) % hueMaxValue) + hueMaxValue) % hueMaxValue;
+   m_saturation = static_cast<int>(saturation);
+   return *this;
+}
+
+std::string LightCommand::ToJson() const
+{
+   std::string json = "{";
+   auto add = [&json](const std::string& item)
+   {
+      if (json.size() > 1)
+         json += ",";
+      json += item;
+   };
+   if (m_brightness)
+      add("\"bri\":" + std::to_string(*m_brightness));
+   if (m_hue)
+      add("\"hue\":" + std::to_string(*m_hue));
+   if (m_saturation)
+      add("\"sat\":" + std::to_string(*m_saturation));
+   if (m_on)
+      add(std::string("\"on\":") + (*m_on ? "true" : "false"));
+   if (m_transitionTimeMs)
+   {
+      long long ticks = static_cast<long long>(*m_transitionTimeMs + 0.5) * 10000;
+      double totalSeconds = static_cast<double>(ticks) * (1.0 / 10000000);
+      add("\"transitiontime\":" + std::to_string(static_cast<int>(totalSeconds * 10)));
+   }
+   return json + "}";
+}
+
+LocalHueClient::LocalHueClient(const std::string& ip)
+{
+#ifdef _WIN32
+   WSADATA wsaData;
+   WSAStartup(MAKEWORD(2, 2), &wsaData);
+#endif
+   m_host = ip;
+   m_port = "80";
+   if (!ip.empty() && ip[0] == '[')
+   {
+      size_t close = ip.find(']');
+      m_host = ip.substr(1, close == std::string::npos ? std::string::npos : close - 1);
+      if (close != std::string::npos && close + 1 < ip.size() && ip[close + 1] == ':')
+         m_port = ip.substr(close + 2);
+   }
+   else if (std::count(ip.begin(), ip.end(), ':') == 1)
+   {
+      m_host = ip.substr(0, ip.find(':'));
+      m_port = ip.substr(ip.find(':') + 1);
+   }
+   m_sender = std::thread(&LocalHueClient::SenderDoIt, this);
+}
+
+LocalHueClient::~LocalHueClient()
+{
+   {
+      std::lock_guard<std::mutex> lock(m_queueLocker);
+      m_keepSenderAlive = false;
+   }
+   m_queueCondition.notify_all();
+   if (m_sender.joinable())
+      m_sender.join();
+#ifdef _WIN32
+   WSACleanup();
+#endif
+}
+
+void LocalHueClient::Initialize(const std::string& appKey) { m_appKey = appKey; }
+
+std::string LocalHueClient::ApiBase() const
+{
+   bool blank = std::all_of(m_appKey.begin(), m_appKey.end(), [](unsigned char c) { return std::isspace(c) != 0; });
+   return blank ? "/api/" : "/api/" + m_appKey + "/";
+}
+
+bool LocalHueClient::Request(const std::string& method, const std::string& path, const std::string& body, int& status, std::string& response) const
+{
+   status = 0;
+   response.clear();
+
+   addrinfo hints {};
+   hints.ai_family = AF_UNSPEC;
+   hints.ai_socktype = SOCK_STREAM;
+   addrinfo* addresses = nullptr;
+   if (getaddrinfo(m_host.c_str(), m_port.c_str(), &hints, &addresses) != 0 || !addresses)
+      return false;
+
+   Socket s = InvalidSocket;
+   for (addrinfo* a = addresses; a && s == InvalidSocket; a = a->ai_next)
+   {
+      s = socket(a->ai_family, a->ai_socktype, a->ai_protocol);
+      if (s != InvalidSocket && !ConnectWithTimeout(s, a->ai_addr, static_cast<int>(a->ai_addrlen), RequestTimeoutMs))
+      {
+         CloseSocket(s);
+         s = InvalidSocket;
+      }
+   }
+   freeaddrinfo(addresses);
+   if (s == InvalidSocket)
+      return false;
+
+   std::string host = m_host.find(':') != std::string::npos ? "[" + m_host + "]" : m_host;
+   if (m_port != "80")
+      host += ":" + m_port;
+   std::string request = method + " " + path + " HTTP/1.1\r\nHost: " + host + "\r\n";
+   if (method != "GET")
+      request += "Content-Type: application/json; charset=utf-8\r\nContent-Length: " + std::to_string(body.size()) + "\r\n";
+   request += "Connection: close\r\n\r\n" + body;
+
+   bool sent = true;
+   for (size_t at = 0; at < request.size();)
+   {
+      int n = send(s, request.data() + at, static_cast<int>(request.size() - at), 0);
+      if (n <= 0)
+      {
+         sent = false;
+         break;
+      }
+      at += static_cast<size_t>(n);
+   }
+
+   std::string raw;
+   if (sent)
+   {
+      char buffer[8192];
+      while (raw.size() < MaxResponseSize && !ResponseComplete(raw))
+      {
+         int n = recv(s, buffer, sizeof(buffer), 0);
+         if (n <= 0)
+            break;
+         raw.append(buffer, static_cast<size_t>(n));
+      }
+   }
+   CloseSocket(s);
+
+   size_t headerEnd = raw.find("\r\n\r\n");
+   if (headerEnd == std::string::npos || raw.compare(0, 5, "HTTP/") != 0)
+      return false;
+   size_t space = raw.find(' ');
+   if (space == std::string::npos || space > headerEnd)
+      return false;
+   status = std::atoi(raw.c_str() + space + 1);
+   response = raw.substr(headerEnd + 4);
+   if (ToLower(raw.substr(0, headerEnd)).find("transfer-encoding: chunked") != std::string::npos)
+      response = Dechunk(response);
+   return true;
+}
+
+bool LocalHueClient::CheckConnection()
+{
+   int status = 0;
+   std::string response;
+   if (!Request("GET", "/description.xml", "", status, response) || status < 200 || status > 299)
+      return false;
+   bool blank = std::all_of(response.begin(), response.end(), [](unsigned char c) { return std::isspace(c) != 0; });
+   if (!blank && ToLower(response).find("philips hue bridge") == std::string::npos)
+      return false;
+
+   if (!Request("GET", ApiBase(), "", status, response) || status < 200 || status > 299)
+      return false;
+   size_t first = response.find_first_not_of(" \t\r\n");
+   if (first != std::string::npos && response[first] == '[' && response.find("\"error\"") != std::string::npos)
+      return false;
+   return true;
+}
+
+void LocalHueClient::SendCommandAsync(const LightCommand& command, const std::vector<std::string>& lightList)
+{
+   std::string json = command.ToJson();
+   {
+      std::lock_guard<std::mutex> lock(m_queueLocker);
+      for (const std::string& lightId : lightList)
+         m_queue.emplace_back(ApiBase() + "lights/" + lightId + "/state", json);
+   }
+   m_queueCondition.notify_all();
+}
+
+void LocalHueClient::Flush(int timeoutMs)
+{
+   std::unique_lock<std::mutex> lock(m_queueLocker);
+   m_queueCondition.wait_for(lock, std::chrono::milliseconds(timeoutMs), [this]() { return m_queue.empty() && !m_sending; });
+}
+
+void LocalHueClient::SenderDoIt()
+{
+   std::unique_lock<std::mutex> lock(m_queueLocker);
+   while (true)
+   {
+      m_queueCondition.wait(lock, [this]() { return !m_queue.empty() || !m_keepSenderAlive; });
+      if (!m_keepSenderAlive)
+         break;
+      std::pair<std::string, std::string> item = m_queue.front();
+      m_queue.pop_front();
+      m_sending = true;
+      lock.unlock();
+
+      int status = 0;
+      std::string response;
+      Request("PUT", item.first, item.second, status, response);
+
+      lock.lock();
+      m_sending = false;
+      m_queueCondition.notify_all();
+   }
+}
+
+}
diff --git a/src/cab/out/philipshue/LocalHueClient.h b/src/cab/out/philipshue/LocalHueClient.h
new file mode 100644
index 0000000..b5220e0
--- /dev/null
+++ b/src/cab/out/philipshue/LocalHueClient.h
@@ -0,0 +1,66 @@
+#pragma once
+
+// Stands in for Q42.HueApi 3.21.0's LocalHueClient and LightCommand (Michiel Post, Q42, MIT), which
+// DirectOutput's PhilipsHueController uses: the same requests to the bridge's local HTTP interface, the
+// commands written as Q42.HueApi writes them, and its RGB to hue, saturation and brightness
+// conversion (Q42.HueApi.ColorConverters 3.20.1, HSB). For Visual Pinball Infinite.
+
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+
+namespace DOF
+{
+
+class LightCommand
+{
+public:
+   std::optional<uint8_t> m_brightness;
+   std::optional<int> m_hue;
+   std::optional<int> m_saturation;
+   std::optional<bool> m_on;
+   std::optional<int> m_transitionTimeMs;
+
+   void SetTransitionTime(int milliseconds) { m_transitionTimeMs = milliseconds; }
+   void SetOn(bool on) { m_on = on; }
+   bool GetOn() const { return m_on.value_or(false); }
+   LightCommand& TurnOff();
+   LightCommand& SetColor(const std::string& hexColor);
+   std::string ToJson() const;
+};
+
+class LocalHueClient
+{
+public:
+   LocalHueClient(const std::string& ip);
+   ~LocalHueClient();
+
+   void Initialize(const std::string& appKey);
+   bool CheckConnection();
+   void SendCommandAsync(const LightCommand& command, const std::vector<std::string>& lightList);
+   void Flush(int timeoutMs);
+
+private:
+   std::string ApiBase() const;
+   bool Request(const std::string& method, const std::string& path, const std::string& body, int& status, std::string& response) const;
+   void SenderDoIt();
+
+   std::string m_host;
+   std::string m_port;
+   std::string m_appKey;
+
+   std::mutex m_queueLocker;
+   std::condition_variable m_queueCondition;
+   std::deque<std::pair<std::string, std::string>> m_queue;
+   bool m_keepSenderAlive = true;
+   bool m_sending = false;
+   std::thread m_sender;
+};
+
+}
