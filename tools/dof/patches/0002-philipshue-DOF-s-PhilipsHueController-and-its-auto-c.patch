+#include "../../../general/StringExtensions.h"
+#include "../../../general/MathExtensions.h"
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <stdexcept>
+
+namespace DOF
+{
+
+namespace
+{
+
+long long NowMs() { return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count(); }
+
+std::string Hex2(uint8_t value)
+{
+   char buffer[3];
+   snprintf(buffer, sizeof(buffer), "%02x", value);
+   return buffer;
+}
+
+}
+
+std::map<int, PhilipsHueController::PhilipsHueControllerUnit*> PhilipsHueController::s_philipsHueControllerUnits;
+bool PhilipsHueController::s_unitsInitialized = false;
+
+void PhilipsHueController::InitializeUnits()
+{
+   if (!s_unitsInitialized)
+   {
+      for (int i = 0; i <= 1; i++)
+         s_philipsHueControllerUnits[i] = new PhilipsHueControllerUnit(i);
+      s_unitsInitialized = true;
+   }
+}
+
+void PhilipsHueController::SetId(int value)
+{
+   if (!MathExtensions::IsBetween(value, 0, 1))
+      throw std::runtime_error(StringExtensions::Build("PhilipsHueController Ids must be between 0-1. The supplied Id {0} is out of range.", std::to_string(value)));
+
+   std::lock_guard<std::mutex> lock(m_idUpdateLocker);
+   if (m_id != value)
+   {
+      if (GetName().empty() || GetName() == StringExtensions::Build("PhilipsHueController {0:0}", std::to_string(m_id)))
+         SetName(StringExtensions::Build("PhilipsHueController {0:0}", std::to_string(value)));
+
+      m_id = value;
+   }
+}
+
+void PhilipsHueController::SetBridgeIP(const std::string& value)
+{
+   std::lock_guard<std::mutex> lock(m_idUpdateLocker);
+   InitializeUnits();
+   s_philipsHueControllerUnits.at(m_id)->SetBridgeIP(value);
+   m_bridgeIP = value;
+}
+
+void PhilipsHueController::SetBridgeKey(const std::string& value)
+{
+   std::lock_guard<std::mutex> lock(m_idUpdateLocker);
+   InitializeUnits();
+   s_philipsHueControllerUnits.at(m_id)->SetBridgeKey(value);
+   m_bridgeKey = value;
+}
+
+void PhilipsHueController::SetBridgeDeviceType(const std::string& value)
+{
+   std::lock_guard<std::mutex> lock(m_idUpdateLocker);
+   InitializeUnits();
+   s_philipsHueControllerUnits.at(m_id)->SetBridgeDeviceType(value);
+   m_bridgeDeviceType = value;
+}
+
+void PhilipsHueController::Update()
+{
+   InitializeUnits();
+   s_philipsHueControllerUnits.at(m_id)->TriggerPhilipsHueControllerUpdaterThread();
+}
+
+void PhilipsHueController::Init(Cabinet* cabinet)
+{
+   AddOutputs();
+   InitializeUnits();
+   s_philipsHueControllerUnits.at(m_id)->Init(cabinet);
+   Log::Write(StringExtensions::Build("PhilipsHueController Id:{0} initialized and updater thread started.", std::to_string(m_id)));
+}
+
+void PhilipsHueController::Finish()
+{
+   InitializeUnits();
+   s_philipsHueControllerUnits.at(m_id)->Finish();
+   s_philipsHueControllerUnits.at(m_id)->ShutdownLighting();
+   s_philipsHueControllerUnits.at(m_id)->FlushCommands();
+   Log::Write(StringExtensions::Build("PhilipsHueController Id:{0} finished and updater thread stopped.", std::to_string(m_id)));
+}
+
+void PhilipsHueController::AddOutputs()
+{
+   OutputList* outputs = GetOutputs();
+   for (int i = 1; i <= 150; i++)
+   {
+      bool found = false;
+      for (IOutput* output : *outputs)
+      {
+         if (output->GetNumber() == i)
+         {
+            found = true;
+            break;
+         }
+      }
+
+      if (!found)
+      {
+         Output* newOutput = new Output();
+         newOutput->SetName(StringExtensions::Build("{0}.{1:00}", GetName(), std::to_string(i)));
+         newOutput->SetNumber(i);
+         outputs->Add(newOutput);
+      }
+   }
+}
+
+void PhilipsHueController::OnOutputValueChanged(IOutput* output)
+{
+   IOutput* on = output;
+
+   if (!MathExtensions::IsBetween(on->GetNumber(), 1, 150))
+   {
+      throw std::runtime_error(
+         StringExtensions::Build("PhilipsHueController output numbers must be in the range of 1-150. The supplied output number {0} is out of range.", std::to_string(on->GetNumber())));
+   }
+
+   InitializeUnits();
+   PhilipsHueControllerUnit* s = s_philipsHueControllerUnits.at(m_id);
+
+   on = TableOverrideSettings::GetInstance()->GetNewRecalculatedOutput(on, 70, m_id);
+
+   IOutput* scheduled = ScheduledSettings::GetInstance().GetNewRecalculatedOutput(on, 70, m_id);
+   s->UpdateValue(scheduled);
+
+   if (scheduled != on && scheduled != output)
+      delete scheduled;
+   if (on != output)
+      delete on;
+}
+
+PhilipsHueController::PhilipsHueController() { InitializeUnits(); }
+
+PhilipsHueController::PhilipsHueController(int id)
+   : PhilipsHueController()
+{
+   SetId(id);
+}
+
+PhilipsHueController::~PhilipsHueController() { }
+
+void PhilipsHueController::ConnectHub()
+{
+   InitializeUnits();
+   s_philipsHueControllerUnits.at(m_id)->ConnectUnit();
+}
+
+tinyxml2::XMLElement* PhilipsHueController::ToXml(tinyxml2::XMLDocument& doc) const
+{
+   tinyxml2::XMLElement* element = doc.NewElement(GetXmlElementName().c_str());
+
+   auto add = [&doc, element](const char* name, const std::string& value)
+   {
+      tinyxml2::XMLElement* child = doc.NewElement(name);
+      child->SetText(value.c_str());
+      element->InsertEndChild(child);
+   };
+   add("Name", GetName());
+   add("Id", std::to_string(m_id));
+   add("BridgeIP", m_bridgeIP);
+   add("BridgeKey", m_bridgeKey);
+   add("BridgeDeviceType", m_bridgeDeviceType);
+
+   return element;
+}
+
+bool PhilipsHueController::FromXml(const tinyxml2::XMLElement* element)
+{
+   if (!element)
+      return false;
+
+   auto text = [element](const char* name) -> const char*
+   {
+      const tinyxml2::XMLElement* child = element->FirstChildElement(name);
+      return child ? child->GetText() : nullptr;
+   };
+
+   if (const char* name = text("Name"))
+      SetName(name);
+
+   if (const char* id = text("Id"))
+   {
+      try
+      {
+         SetId(std::stoi(id));
+      }
+      catch (...)
+      {
+         return false;
+      }
+   }
+
+   if (const char* bridgeIP = text("BridgeIP"))
+      SetBridgeIP(bridgeIP);
+   if (const char* bridgeKey = text("BridgeKey"))
+      SetBridgeKey(bridgeKey);
+   if (const char* bridgeDeviceType = text("BridgeDeviceType"))
+      SetBridgeDeviceType(bridgeDeviceType);
+
+   return true;
+}
+
+PhilipsHueController::PhilipsHueControllerUnit::PhilipsHueControllerUnit(int id)
+   : m_id(id)
+   , m_index(id)
+{
+   m_bridgecommunicationlastTimestamp = NowMs();
+   m_bridgecommunicationlastpingTimestamp = NowMs();
+
+   std::fill_n(m_newValue, 150, 0);
+   std::fill_n(m_currentValue, 150, 0);
+   std::fill_n(m_lastValueSent, 150, 0);
+   std::fill_n(m_lastStateSent, 150, false);
+
+   std::fill_n(m_affectedLights, 50, false);
+   InitUnit();
+}
+
+PhilipsHueController::PhilipsHueControllerUnit::~PhilipsHueControllerUnit()
+{
+   if (m_keepPhilipsHueControllerUpdaterAlive.load())
+      Finish();
+   FlushCommands();
+}
+
+void PhilipsHueController::PhilipsHueControllerUnit::Init(Cabinet* cabinet) { StartPhilipsHueControllerUpdaterThread(); }
+
+void PhilipsHueController::PhilipsHueControllerUnit::Finish()
+{
+   TerminatePhilipsHueControllerUpdaterThread();
+   ShutdownLighting();
+}
+
+void PhilipsHueController::PhilipsHueControllerUnit::UpdateValue(IOutput* output)
+{
+   if (!MathExtensions::IsBetween(output->GetNumber(), 1, 150))
+      return;
+
+   int zeroBasedOutputNumber = output->GetNumber() - 1;
+   std::lock_guard<std::mutex> lock(m_valueChangeLocker);
+   if (m_newValue[zeroBasedOutputNumber] != output->GetOutput())
+   {
+      m_newValue[zeroBasedOutputNumber] = output->GetOutput();
+      m_updateRequired = true;
+   }
+}
+
+void PhilipsHueController::PhilipsHueControllerUnit::CopyNewToCurrent() { std::copy(m_newValue, m_newValue + 150, m_currentValue); }
+
+bool PhilipsHueController::PhilipsHueControllerUnit::IsUpdaterThreadAlive() { return m_philipsHueControllerUpdater.joinable(); }
+
+void PhilipsHueController::PhilipsHueControllerUnit::StartPhilipsHueControllerUpdaterThread()
+{
+   std::lock_guard<std::mutex> lock(m_philipsHueControllerUpdaterThreadLocker);
+   if (!IsUpdaterThreadAlive())
+   {
+      m_keepPhilipsHueControllerUpdaterAlive.store(true);
+      m_updaterThreadFinished = false;
+      m_philipsHueControllerUpdater = std::thread(&PhilipsHueControllerUnit::PhilipsHueControllerUpdaterDoIt, this);
+   }
+}
+
+void PhilipsHueController::PhilipsHueControllerUnit::TerminatePhilipsHueControllerUpdaterThread()
+{
+   std::unique_lock<std::mutex> lock(m_philipsHueControllerUpdaterThreadLocker);
+   if (m_philipsHueControllerUpdater.joinable())
+   {
+      m_keepPhilipsHueControllerUpdaterAlive.store(false);
+      TriggerPhilipsHueControllerUpdaterThread();
+      lock.unlock();
+
+      auto start = std::chrono::steady_clock::now();
+      while (!m_updaterThreadFinished && std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count() < 1000)
+         std::this_thread::sleep_for(std::chrono::milliseconds(10));
+
+      if (m_updaterThreadFinished)
+         m_philipsHueControllerUpdater.join();
+      else
+         m_philipsHueControllerUpdater.detach();
+   }
+}
+
+void PhilipsHueController::PhilipsHueControllerUnit::TriggerPhilipsHueControllerUpdaterThread()
+{
+   m_triggerUpdate.store(true);
+   m_triggerCondition.notify_one();
+}
+
+void PhilipsHueController::PhilipsHueControllerUnit::PhilipsHueControllerUpdaterDoIt()
+{
+   try
+   {
+      ResetFadeTime();
+   }
+   catch (const std::exception&)
+   {
+      Log::Exception(StringExtensions::Build("A exception occurred while setting the fadetime for PhilipsHueController {0} to 0.", std::to_string(m_index)));
+      m_updaterThreadFinished = true;
+      return;
+   }
+
+   int failCnt = 0;
+   while (m_keepPhilipsHueControllerUpdaterAlive.load())
+   {
+      try
+      {
+         if (IsPresent())
+            SendPhilipsHueControllerUpdate();
+         failCnt = 0;
+      }
+      catch (const std::exception&)
+      {
+         Log::Exception(StringExtensions::Build("A error occurred when updating PhilipsHueController {0}", std::to_string(m_id)));
+         failCnt++;
+
+         if (failCnt > MAX_UPDATE_FAIL_COUNT)
+         {
+            Log::Exception(StringExtensions::Build("More than {0} consecutive updates failed for PhilipsHueController {1}. Updater thread will terminate.",
+               std::to_string(MAX_UPDATE_FAIL_COUNT), std::to_string(m_id)));
+            m_keepPhilipsHueControllerUpdaterAlive.store(false);
+         }
+      }
+
+      if (m_keepPhilipsHueControllerUpdaterAlive.load())
+      {
+         std::unique_lock<std::mutex> lock(m_philipsHueControllerUpdaterThreadLocker);
+         m_triggerCondition.wait_for(lock, std::chrono::milliseconds(50), [this]() { return m_triggerUpdate.load() || !m_keepPhilipsHueControllerUpdaterAlive.load(); });
+      }
+      m_triggerUpdate.store(false);
+   }
+   m_updaterThreadFinished = true;
+}
+
+void PhilipsHueController::PhilipsHueControllerUnit::SendPhilipsHueControllerUpdate()
+{
+   long long bridgecommunicationDelta = NowMs() - m_bridgecommunicationlastTimestamp;
+   long long bridgecommunicationpingDelta = NowMs() - m_bridgecommunicationlastpingTimestamp;
+
+   int bridgebulbID = 0;
+   if (IsPresent())
+   {
+      std::lock_guard<std::mutex> updateLock(m_philipsHueControllerUpdateLocker);
+      {
+         std::lock_guard<std::mutex> valueLock(m_valueChangeLocker);
+         if (!m_updateRequired)
+            return;
+
+         CopyNewToCurrent();
+         m_updateRequired = false;
+      }
+
+      for (int i = 0; i < 150; i++)
+      {
+         if (m_currentValue[i] != m_lastValueSent[i] || m_currentValue[i + 1] != m_lastValueSent[i + 1] || m_currentValue[i + 2] != m_lastValueSent[i + 2])
+         {
+            LightCommand newbridgeCommand;
+            bridgebulbID = ((i + 2 + 1) / 3);
+            std::string newhexColor = Hex2(m_currentValue[i]) + Hex2(m_currentValue[i + 1]) + Hex2(m_currentValue[i + 2]);
+
+            if ((m_lastValueSent[i] == 0 && m_currentValue[i] > 0) || (m_lastValueSent[i + 1] == 0 && m_currentValue[i + 1] > 0)
+               || (m_lastValueSent[i + 2] == 0 && m_currentValue[i + 2] > 0))
+               newbridgeCommand.SetTransitionTime(0);
+            else
+               newbridgeCommand.SetTransitionTime(m_bridgecommunicationDelay.load());
+
+            if (m_currentValue[i] == 0 && m_currentValue[i + 1] == 0 && m_currentValue[i + 2] == 0)
+            {
+               newbridgeCommand.TurnOff();
+               newbridgeCommand.SetOn(false);
+               newbridgeCommand.SetTransitionTime(m_bridgecommunicationDelay.load());
+            }
+            else
+            {
+               newbridgeCommand.SetOn(true);
+               newbridgeCommand.SetColor(newhexColor);
+
+               m_affectedLights[bridgebulbID - 1] = true;
+            }
+
+            m_lastValueSent[i] = m_currentValue[i];
+            m_lastValueSent[i + 1] = m_currentValue[i + 1];
+            m_lastValueSent[i + 2] = m_currentValue[i + 2];
+
+            if (bridgecommunicationDelta >= m_bridgecommunicationDelay.load() || newbridgeCommand.GetOn() == false || newhexColor == "000000")
+            {
+               m_hueClient->SendCommandAsync(newbridgeCommand, { std::to_string(bridgebulbID) });
+
+               m_bridgecommunicationlastTimestamp = NowMs();
+            }
+         }
+
+         i += 2;
+      }
+
+      if (bridgecommunicationpingDelta >= m_bridgecommunicationPing)
+      {
+         m_bridgecommunicationlastpingTimestamp = NowMs();
+         StartConnectionCheck();
+      }
+   }
+}
+
+void PhilipsHueController::PhilipsHueControllerUnit::ShutdownLighting()
+{
+   int currentlightID = 0;
+   for (int i = 0; i < 50; i++)
+   {
+      if (m_affectedLights[i])
+      {
+         currentlightID = i + 1;
+         LightCommand newbridgeCommand;
+         newbridgeCommand.TurnOff();
+         newbridgeCommand.SetOn(false);
+         newbridgeCommand.SetTransitionTime(2000);
+         Log::Write("PhilipsHueController.ShutdownLighting, Turning off light #" + std::to_string(currentlightID));
+         if (m_hueClient)
+            m_hueClient->SendCommandAsync(newbridgeCommand, { std::to_string(currentlightID) });
+      }
+   }
+
+   std::fill_n(m_lastStateSent, 150, false);
+}
+
+void PhilipsHueController::PhilipsHueControllerUnit::ResetFadeTime() { Log::Write("PhilipsHueController.ResetFadeTime"); }
+
+bool PhilipsHueController::PhilipsHueControllerUnit::IsPresent()
+{
+   if (!MathExtensions::IsBetween(m_id, 0, 3) || m_bridgeConnected.load() == false)
+      return false;
+   return m_index >= 0;
+}
+
+void PhilipsHueController::PhilipsHueControllerUnit::InitUnit()
+{
+   if (m_index >= 0)
+   {
+      std::fill_n(m_lastValueSent, 150, 0);
+
+      std::fill_n(m_lastStateSent, 150, false);
+      std::fill_n(m_lastValueSent, 150, 0);
+   }
+}
+
+void PhilipsHueController::PhilipsHueControllerUnit::ConnectUnit()
+{
+   if (m_bridgeIP == "" || m_bridgeKey == "")
+      Log::Write("PhilipsHueController.PhilipsHueControllerUnit... unable to connect to bridge, no IP or key supplied in Cabinet.xml");
+   else
+   {
+      Log::Write("PhilipsHueController.PhilipsHueControllerUnit... connecting to bridge... ip=" + m_bridgeIP + " key=(hidden)");
+      if (m_connectionCheck.joinable())
+         m_connectionCheck.join();
+      delete m_hueClient;
+      m_hueClient = new LocalHueClient(m_bridgeIP);
+      m_hueClient->Initialize(m_bridgeKey);
+
+      StartConnectionCheck();
+   }
+}
+
+void PhilipsHueController::PhilipsHueControllerUnit::StartConnectionCheck()
+{
+   if (m_connectionCheckRunning.exchange(true))
+      return;
+   if (m_connectionCheck.joinable())
+      m_connectionCheck.join();
+   m_connectionCheck = std::thread(
+      [this]()
+      {
+         CheckConnection();
+         m_connectionCheckRunning = false;
+      });
+}
+
+void PhilipsHueController::PhilipsHueControllerUnit::CheckConnection()
+{
+   long long startTimestamp = NowMs();
+   long long deltaTimestamp = 0;
+   long long adjustedPing = 0;
+   bool connectionResult = m_hueClient->CheckConnection();
+
+   m_bridgeConnected = connectionResult;
+
+   if (connectionResult == true)
+   {
+      deltaTimestamp = NowMs() - startTimestamp;
+      adjustedPing = static_cast<int>(std::nearbyint(static_cast<int>(deltaTimestamp) * m_bridgecommunicationdelayFactor));
+
+      if (adjustedPing > m_bridgecommunicationminimumDelay)
+      {
+         m_bridgecommunicationDelay = static_cast<int>(adjustedPing);
+         Log::Write("PhilipsHueController.CheckConnection IP=" + m_bridgeIP + "... current connection lag =" + std::to_string(deltaTimestamp) + "ms, recalibrating from "
+            + std::to_string(m_bridgecommunicationDelay.load()) + "ms -> " + std::to_string(deltaTimestamp) + "ms, buffer factor=1.2 -> " + std::to_string(adjustedPing) + "ms");
+      }
+      else
+      {
+         m_bridgecommunicationDelay = m_bridgecommunicationminimumDelay;
+         Log::Write("PhilipsHueController.CheckConnection IP=" + m_bridgeIP + "... current connection lag =" + std::to_string(deltaTimestamp) + "ms, ignoring and using minimum "
+            + std::to_string(m_bridgecommunicationminimumDelay) + "ms to avoid bridge overload");
+      }
+   }
+   else
+   {
+      Log::Write("PhilipsHueController.CheckConnection... lost connection, or unable to connect to bridge using BridgeIP=" + m_bridgeIP
+         + " and BridgeKey=(hidden)... will ignore for now and attempt reconnecting every " + std::to_string(m_bridgecommunicationPing) + "ms");
+   }
+}
+
+void PhilipsHueController::PhilipsHueControllerUnit::FlushCommands()
+{
+   if (m_connectionCheck.joinable())
+      m_connectionCheck.join();
+   if (m_hueClient)
+   {
+      m_hueClient->Flush(3000);
+      delete m_hueClient;
+      m_hueClient = nullptr;
+   }
+   m_bridgeConnected = false;
+}
+
+}
